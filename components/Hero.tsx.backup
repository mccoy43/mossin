          }}
          style={{
            top: `${15 + i * 10}%`,
            left: `${5 + i * 12}%`,
          }}
        ></motion.div>
      ))}

      {/* Interactive glow effect */}
      <div
        className="absolute inset-0 pointer-events-none"
        style={{
          background: `radial-gradient(circle at ${50 + mousePosition.x}% ${50 + mousePosition.y}%, rgba(212, 175, 55, 0.05) 0%, transparent 50%)`,
        }}
      ></div>

      <div className="relative z-10 container mx-auto px-4 text-center">
        <motion.div
          variants={containerVariants}
          initial="hidden"
          animate="visible"
          className="max-w-5xl mx-auto"
        >
          {/* Premium badge */}
          <motion.div
            variants={itemVariants}
            className="inline-flex items-center gap-2 bg-gradient-to-r from-gold/20 to-deep-blue/20 backdrop-blur-sm border border-gold/30 rounded-full px-6 py-3 mb-8"
          >
            <span className="w-2 h-2 bg-gold rounded-full animate-pulse"></span>
            <span className="text-gold font-semibold text-sm tracking-wide">PREMIUM LAUNDRY SERVICE</span>
            <span className="w-2 h-2 bg-gold rounded-full animate-pulse"></span>
          </motion.div>

          {/* Enhanced headline */}
          <motion.h1
            variants={itemVariants}
            className="font-heading text-5xl md:text-7xl lg:text-8xl font-black mb-6 leading-none tracking-tight"
          >
            <span className="block text-white">WE PICK UP,</span>
            <motion.span
              className="block text-transparent bg-clip-text bg-gradient-to-r from-gold via-yellow-300 to-gold animate-luxury-shimmer"
              whileHover={{ scale: 1.02 }}
              transition={{ type: "spring", stiffness: 300 }}
            >
              WASH, FOLD
            </motion.span>
            <span className="block text-white">& IRON YOUR</span>
            <span className="block text-gold text-luxury relative">
              LAUNDRY
              <motion.div
                className="absolute -bottom-2 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent"
